+
+function utf8OrHex(bytes) {
+    const s = toStr(bytes);
+    if (s !== null) return s;
+    try { return new TextDecoder('utf-8', { fatal: false }).decode(new Uint8Array(bytes)); }
+    catch (e) { return AES.toHex(bytes); }
