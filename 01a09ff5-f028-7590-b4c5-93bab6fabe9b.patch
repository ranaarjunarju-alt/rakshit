++                                if a2.mnemonic == 'add' and a2.op_str.startswith(reg + ','):
++                                    try:
++                                        base[reg] = nxt + int(a2.op_str.split(',')[1].strip(), 0)
++                                    except ValueError:
++                                        pass
++                                    break
++                            break
