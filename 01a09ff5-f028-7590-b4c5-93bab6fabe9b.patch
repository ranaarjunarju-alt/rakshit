+function hookJniFn(name, sig, fnPtr, off) {
+    const key = name + sig;
+    if (JNI_HOOKED[key]) return;
+    JNI_HOOKED[key] = true;
+    try {
+        Interceptor.attach(fnPtr, {
+            onEnter(args) {
