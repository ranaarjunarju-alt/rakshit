+    rows=[raw[i+32*r:i+32*r+16] for r in range(11)]
+    exp=[le[16*r:16*r+16] for r in range(11)]
+    print("all 11 rows match with stride 32:",rows==exp)
+    rows16=[raw[i+16*r:i+16*r+16] for r in range(11)]
