+            t=t[1:]+t[:1];t=[SBOX[b] for b in t];t[0]^=RCON[i//nk-1]
+        elif nk>6 and i%nk==4: t=[SBOX[b] for b in t]
+        w.append([w[i-nk][j]^t[j] for j in range(4)])
+    return w,nr
