+    if mn in ('strb','sturb') and re.search(r'w\d+, \[(x29|sp), #-?0x[0-9a-f]*\d*\]$',op) and False: return True
+    return False
+
+def analyze(t, maxtrace=4000, verbose_blocks=None):
