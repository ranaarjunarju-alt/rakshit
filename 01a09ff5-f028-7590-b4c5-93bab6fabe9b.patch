++            # of the following instruction, so the pattern to match is:
++            #     call <addr>   where <addr> == address of the NEXT insn
++            #     pop  REG
++            #     add  REG, K          ; REG = <addr> + K  == GOT base
++            # then every [REG + disp] resolves to GOT_base + disp.
