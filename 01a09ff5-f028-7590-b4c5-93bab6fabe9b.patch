+            blobOffset: '0x' + SIGNATURE_PIN_BLOB_OFF.toString(16),
+            spoofing: !!CONFIG.spoofSignature,
+            originalCertLen: b64decode(ORIGINAL_SIGNER_CERT_B64).length,
+            originalCertSha256: null,
