+function findModule() {
+    try { const m = Process.findModuleByName(MODULE); if (m) return m; } catch (e) {}
+    try {
+        const m = Process.findModuleByAddress(Module.findExportByName(null, 'JNI_OnLoad'));
+        if (m && m.name === MODULE) return m;
+    } catch (e) {}
+    return null;
