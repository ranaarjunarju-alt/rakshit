+                        }
+                    });
+                } catch (e) { this.java.push('<env err ' + e + '>'); }
+            },
+            onLeave(retval) {
+                let out = null;
+                if (this.sig.indexOf(')Ljava/lang/String;') > 0 && !retval.isNull()) {
+                    try { out = Java.vm.getEnv().getStringUtfChars(retval, null).readUtf8String(); }
+                    catch (e) { out = '<' + e + '>'; }
