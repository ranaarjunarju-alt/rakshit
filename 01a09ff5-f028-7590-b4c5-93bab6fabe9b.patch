+const SINK = {
+    fd: -1,
+    path: null,
+    tried: [],
+    ring: [],
+    seq: 0,
+    bytesWritten: 0,
+    writeErrors: 0,
+    byKind: {},
+    keys: {},          /* hex -> {count, firstSeen, label, len, sources} */
+    endpoints: {},     /* url  -> count */
+    natives: {},       /* name -> {calls, lastRet, totalMs} */
+    detections: {},    /* fn   -> {calls, returns: {value: count}} */
+    started: Date.now()
