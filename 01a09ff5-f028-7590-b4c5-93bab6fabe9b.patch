+            onEnter(args) { this.path = cstr(args[0], 256); },
+            onLeave(retval) {
+                if (!this.path) return;
+                const fd = retval.toInt32();
+                if (fd >= 0 && isMapsPath(this.path)) {
+                    MAP_FDS.add(fd);
+                    LOG.det({ what: fn + '("' + this.path + '") -> fd ' + fd,
+                              ret: 'tracked for read() filtering' });
+                }
+            }
+        });
+    });
