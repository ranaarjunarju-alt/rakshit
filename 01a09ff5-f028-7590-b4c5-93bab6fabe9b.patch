+    chk('Te0   @0x118b0', hexOf(A(OFF.ro_te0), 8),   'a56363c6847c7cf8');
+    chk('Td0   @0x129b0', hexOf(A(OFF.ro_td0), 8),   '50a7f4515365417e');
