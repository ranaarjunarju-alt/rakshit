+        if (contains(buf + off, n, rwxp)) { bad = true; break; }  // RWX mapping => injected code
+        if (contains(buf + off, n, art )) { bad = true; break; }  // patched ART
+        if (contains(buf + off, n, libc)) { bad = true; break; }  // patched libc
+        off = eol + 1;
+    }
+    free(buf);
+    return bad;
+}
+```
