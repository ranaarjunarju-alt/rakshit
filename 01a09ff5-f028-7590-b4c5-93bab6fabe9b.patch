+    chk('Te1 is Te0 rotated right 1 byte', hexOf(A(OFF.ro_te1), 4), '6363c6a5');
+    chk('Te3 is Te0 rotated right 3 bytes', hexOf(A(OFF.ro_te3), 4), 'c6a56363');
+    chk('Td3 is Td0 rotated right 3 bytes', hexOf(A(OFF.ro_td3), 4), '5150a7f4');
