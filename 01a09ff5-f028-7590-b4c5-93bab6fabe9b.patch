++        elif name == 'realloc':
++            ret(self.heap.realloc(x[0], x[1]))
++        elif name == 'posix_memalign':
++            p = self.heap.malloc(x[1]); self.w8(x[0], p); ret(0)
++        elif name in ('memcpy', 'memmove', '__memmove_chk'):
++            n = x[2]
