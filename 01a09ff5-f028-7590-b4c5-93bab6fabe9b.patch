+    const out = parts.join('\n');
+    const bytes = [];
+    for (let i = 0; i < out.length && i < n; i++) bytes.push(out.charCodeAt(i) & 0xff);
+    try { buf.writeByteArray(bytes); } catch (e) { return 0; }
