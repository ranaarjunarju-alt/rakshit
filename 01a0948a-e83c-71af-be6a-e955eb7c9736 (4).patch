+        writeU8(v) { img[o()] = v & 0xff; },
+        writeUtf8String(str) {
+            const b = Buffer.from(String(str), 'utf8');
+            b.copy(img, o());
+            return api;
+        },
+        writeByteArray(bytes) {
+            const b = Buffer.isBuffer(bytes) ? bytes
