+    # heuristic: most common b.eq/b.ne/b.le/b.gt target == dispatcher head
+    tg={}
+    for i in insns:
+        if i.mnemonic in ('b.eq','b.ne','b.le','b.gt','b.lt','b.ge'):
+            m=re.search(r'#(0x[0-9a-f]+)',i.op_str)
+            if m: tg[int(m.group(1),16)]=tg.get(int(m.group(1),16),0)+1
