+for a in sorted(byaddr)[:40]:
+    lst=byaddr[a]
+    print(f"  0x{a:08x} n={len(lst):3d} first_pc=0x{lst[0][0]:x} kinds={set(k for _,_,k in lst)} content={bytes(e.rd(a,8)).hex()}")
