+        emit('warn', { what: 'JNI table unreadable — falling back to the static offsets', err: String(err) });
+        slots = JNI_EXPECT.map(x => ({ slot: x[0], name: x[1], sig: x[2], fnPtr: A(x[3]) }));
+    }
