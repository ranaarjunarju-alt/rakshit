+print(f"pt object @0x{pt:x} -> {bytes(e.rd(pt,24)).hex(' ')}")
+print(f"out      @0x{out:x}")
+print(f"heap brk after allocs = 0x{e.brk:x}")
+reads=[]
+def hook(mu,acc,addr,sz,val,ud):
+    if addr>=HEAP and addr<HEAP+HEAP_SZ:
