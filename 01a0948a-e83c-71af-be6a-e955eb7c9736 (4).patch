+mu.hook_add(UC_HOOK_CODE,hook)
+e.call(0x10c470,x0=pt_s,x1=key_s,x8=out_s,timeout=200*1000000)
+x0,x2=cap[0]
+raw=bytes(mu.mem_read(x0,0x600))
+# locate the key copy
+ki=raw.find(KEY)
