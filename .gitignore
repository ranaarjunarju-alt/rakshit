# ---------------------------------------------------------------------------
# TopFollow reverse-engineering engagement - repository hygiene
#
# Keep:   deliverables (HTML report, Frida lab, threat model, docs),
#         the analysis tooling that produced them, and the small curated
#         evidence files that back specific findings.
# Ignore: bulk decompilation output, extracted APK contents, tool logs and
#         the Python virtualenv. These are multi-hundred-MB regenerable
#         intermediates and do not belong in Git.
# ---------------------------------------------------------------------------

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Extracted APK payload (regenerate with: unzip "<apk>" -d work/apk)
work/apk/

# Bulk decompilation intermediates
work/out/all/
work/out/smali/
work/out/xref/
work/out/dex_full.log
work/out/*.err

# Node (if the Frida lab is ever npm-packaged)
node_modules/
