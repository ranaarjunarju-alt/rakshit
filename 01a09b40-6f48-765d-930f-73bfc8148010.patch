+                    print(f"  ptr in {sec.name:<13} @VA {sec.virtual_address + i:#x} -> {v:#x}")
+                    cnt += 1
+    print(f"  total: {cnt}")
+    print()
+
+    print("--- 4. Code references into the S-box region (ADRP + ADD/LDR) ---")
+    text = [s for s in b.sections if s.name == '.text']
+    refs = []
+    if text:
