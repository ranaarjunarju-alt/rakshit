+
+    sbox = SBOX
+
+    print("--- 1. S-box identification (literal + independent GF(2^8) derivation) ---")
+    print(f"  derived fwd S-box[:16] : {build_sbox()[:16].hex()}")
+    print(f"  derived inv S-box[:16] : {isbox[:16].hex()}")
