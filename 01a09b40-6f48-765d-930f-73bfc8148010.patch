+    s=n.strip('L;').split('/')
+    return '/'.join(s[:3]) if len(s)>=3 else '/'.join(s[:-1])
+c=collections.Counter(pkg(x) for x in classes)
+out['package_heatmap']=c.most_common(80)
+# app classes only
