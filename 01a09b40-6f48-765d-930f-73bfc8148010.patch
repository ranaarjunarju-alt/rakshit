++    items[t]=(sz,off)
++print("map types:",{hex(k):v[0] for k,v in items.items()},file=sys.stderr)
++TYPE_ANNOTATION_SET_ITEM=0x1000
++TYPE_ANNOTATION_SET_REF_LIST=0x1001
++TYPE_ANNOTATION_ITEM=0x2004
++TYPE_ENCODED_ARRAY=0x2005
