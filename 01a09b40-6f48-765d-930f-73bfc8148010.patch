+  /* ---------- set initial active filter ---------- */
+  var first = document.querySelector('#sevFilters .fbtn'); if (first) first.classList.add('on');
+  var firstC = document.querySelector('#catFilters .fbtn'); if (firstC) firstC.classList.add('on');
