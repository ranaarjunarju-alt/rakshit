+    e=raw.find(b'\x00',o,o+maxlen)
+    if e<0: return None
+    try: s=raw[o:e].decode('utf-8')
+    except Exception: return None
+    if not s or sum(1 for c in s if 32<=ord(c)<127)<len(s)*0.92: return None
