++    e=raw.find(b'\x00',o,o+maxlen)
++    if e<0: return None
++    try:
++        s=raw[o:e].decode('ascii')
++        return s if all(32<=ord(c)<127 for c in s) else None
++    except Exception: return None
++def disasm(va, nbytes=900, label=''):
++    o=va2off(va)
