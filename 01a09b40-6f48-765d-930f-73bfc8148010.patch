++    e = Emu(SO)
++    raw = e.raw
++    print(f"\n  image {e.size:,} B mapped at VA 0")
++    print(f"  S-box  @ {SBOX_VA:#x}: {raw[SBOX_VA:SBOX_VA+16].hex(' ')}")
